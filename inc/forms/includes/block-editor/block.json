{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "contact-form-7/contact-form-selector",
  "title": "Forms",
  "category": "widgets",
  "description": "Insert a contact form you have created with Forms.",
  "keywords": ["form"],
  "textdomain": "paulus",
  "attributes": {
    "id": {
      "type": "integer"
    },
    "hash": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "htmlId": {
      "type": "string"
    },
    "htmlName": {
      "type": "string"
    },
    "htmlTitle": {
      "type": "string"
    },
    "htmlClass": {
      "type": "string"
    },
    "output": {
      "enum": ["form", "raw_form"],
      "default": "form"
    }
  },
  "editorScript": ["file:./index.js", "paulus-form-block-editor"]
}
