{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "base",
					"name": "Ground",
					"color": "#b8955f"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#b8955f"
				},
				{
					"slug": "contrast",
					"name": "Ink",
					"color": "#1f1a14"
				},
				{
					"slug": "muted",
					"name": "Muted ink",
					"color": "#3a2f22"
				},
				{
					"slug": "accent",
					"name": "Oxblood",
					"color": "#7a2e1a"
				},
				{
					"slug": "on-accent",
					"name": "On accent",
					"color": "#f4e7cf"
				},
				{
					"slug": "gold",
					"name": "Gold",
					"color": "#7a2e1a"
				},
				{
					"slug": "rule",
					"name": "Rule",
					"color": "#1f1a14"
				},
				{
					"slug": "panel",
					"name": "Panel",
					"color": "#b8955f"
				},
				{
					"slug": "on-panel",
					"name": "On panel",
					"color": "#1f1a14"
				},
				{
					"slug": "accent-1",
					"name": "Accent 1 (parent)",
					"color": "#7a2e1a"
				},
				{
					"slug": "accent-2",
					"name": "Accent 2 (parent)",
					"color": "#c9a873"
				},
				{
					"slug": "accent-3",
					"name": "Accent 3 (parent)",
					"color": "#7a2e1a"
				},
				{
					"slug": "accent-4",
					"name": "Accent 4 (parent)",
					"color": "#4a3d2c"
				},
				{
					"slug": "accent-5",
					"name": "Accent 5 (parent)",
					"color": "#c9a873"
				},
				{
					"slug": "accent-6",
					"name": "Accent 6 (parent)",
					"color": "color-mix(in srgb, currentColor 20%, transparent)"
				}
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1180px"
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Dubidam",
					"fontFamily": "Dubidam, \"EB Garamond\", \"Arslan Wessam\", Georgia, serif"
				},
				{
					"slug": "roman",
					"name": "Cinzel",
					"fontFamily": "Cinzel, \"EB Garamond\", Georgia, serif"
				},
				{
					"slug": "ui",
					"name": "Dubidam (interface)",
					"fontFamily": "Dubidam, \"EB Garamond\", Georgia, serif"
				},
				{
					"slug": "body",
					"name": "Sabon Next LT",
					"fontFamily": "\"Sabon Next LT\", \"EB Garamond\", \"Arslan Wessam\", Georgia, serif"
				},
				{
					"slug": "garamond",
					"name": "EB Garamond",
					"fontFamily": "\"EB Garamond\", \"Arslan Wessam\", Georgia, serif"
				},
				{
					"slug": "label",
					"name": "Special Elite",
					"fontFamily": "\"Special Elite\", \"EB Garamond\", \"Courier New\", monospace"
				},
				{
					"slug": "arabic",
					"name": "Arslan Wessam",
					"fontFamily": "\"Arslan Wessam\", \"EB Garamond\", serif"
				},
				{
					"slug": "manrope",
					"name": "Body (parent alias)",
					"fontFamily": "\"Sabon Next LT\", \"EB Garamond\", \"Arslan Wessam\", Georgia, serif"
				},
				{
					"slug": "fira-code",
					"name": "Monospace",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.125rem"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.5rem",
					"fluid": {
						"min": "1.3rem",
						"max": "1.5rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra large",
					"size": "2.25rem",
					"fluid": {
						"min": "1.75rem",
						"max": "2.25rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Display",
					"size": "4rem",
					"fluid": {
						"min": "2.5rem",
						"max": "4rem"
					}
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700",
					"lineHeight": "1.12"
				},
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--contrast)"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-book",
			"title": "Book landing",
			"postTypes": [
				"page"
			]
		}
	]
}
